{
  "_comment": "Business-struct decoding demo: SafeSection reset context (from FS_SafeSection_Types.h + FS_SafeSection_Prv.h + FS_Reset_Types.h) and DEM primary entries (from Dem_Lcfg.h). The engine parses the C headers (concatenated) into a struct+enum catalog; the inline `structCatalog` below only PATCHES fields with rich `format`s + supplies the union discriminator and a few gap-fill enums (UDS status bits, SW build type) that are not scrapeable from the headers. Binding block->struct is the engine's decision via `blockStructs`. The plugin core stays vendor-blind.",
  "vendor": "Vector MICROSAR FEE V3 (struct decode demo)",
  "engine": "vector-fee-v3",
  "sources": {
    "feeLcfg": "Fee_Lcfg.c",
    "safeSecPrv": "FS_SafeSection_Prv.h",
    "resetTypes": "FS_Reset_Types.h",
    "safeSecTypes": "FS_SafeSection_Types.h",
    "demLcfg": "Dem_Lcfg.h"
  },
  "match": { "ext": [".mot", ".srec", ".s19", ".s28", ".s37", ".hex"], "fileNameIncludes": ["NVM_22"] },
  "options": {
    "alignment": 8,
    "numberOfSectors": 2,
    "sectorSize": 196608,
    "structs": {
      "_comment": "C headers parsed together (order matters: Prv defines sizes used by Types). ARXML sources would be listed here too and parsed via arxmlStructs.",
      "fromSources": ["safeSecPrv", "resetTypes", "safeSecTypes", "demLcfg"]
    },
    "enumsFromDefines": [
      {
        "_comment": "Scrape the AUTOSAR DEM event-id table (#define DemConf_DemEventParameter_<NAME> <id>u) from Dem_Lcfg.h into the DemEventName enum, so a decoded EventId shows its symbolic name. Vendor-blind: the plugin only knows '#define <prefix><NAME> <int>'; the prefix is config.",
        "enum": "DemEventName",
        "source": "demLcfg",
        "prefix": "DemConf_DemEventParameter_",
        "width": 2
      }
    ],
    "structCatalog": {
      "_comment": "Overlay: patches parsed structs by field name (adds `format`, union discriminator/cases) and adds gap-fill enums. Field byte layout still comes from the C headers.",
      "structs": {
        "FS_SafeSection_t_Data": {
          "name": "FS_SafeSection_t_Data",
          "fields": [
            { "name": "u_MapVersion", "format": { "kind": "both" } },
            { "name": "e_SectionState", "format": { "kind": "enum", "enum": "FS_SafeSection_te_State" } },
            { "name": "u_Checksum", "format": { "kind": "hex" } }
          ]
        },
        "FS_SafeSection_t_FsData": {
          "name": "FS_SafeSection_t_FsData",
          "fields": [
            { "name": "e_SharedInfoID", "format": { "kind": "enum", "enum": "FS_SafeSection_te_SharedID" } },
            { "name": "e_ResetReason", "format": { "kind": "enum", "enum": "FS_Reset_te_ResetReason" } },
            { "name": "a_ResetContextData", "format": { "kind": "ascii" } },
            { "name": "u_CycleCounter", "format": { "kind": "duration", "unit": "ms" } },
            {
              "name": "u_SystemFlags",
              "format": {
                "kind": "bitflags",
                "flags": [
                  { "bit": 0, "label": "DCACHE_ON" },
                  { "bit": 1, "label": "ICACHE_ON" },
                  { "bit": 14, "label": "SAFESILENT" },
                  { "bit": 15, "label": "DEBUGGER" }
                ]
              }
            },
            { "name": "u_IntrFaultFlags", "format": { "kind": "hex" } },
            { "name": "u_SwVersion", "format": { "kind": "version", "buildEnum": "FS_InfoBlockBuildType" } },
            { "name": "u_ProcessId", "format": { "kind": "hex" } },
            {
              "_comment": "Union member per FS_SafeSection_te_SharedID of FS_SafeSection_Types.h MAP_VERSION 15 (1 MCU, 2 TASK, 3 OS, 4 VOLTAGE, 5 OSEXT, 6 FCCU, 7 STACK, 8 PMIC). MAP_VERSION 16 instead has 7 STACK_1, 8 STACK_2, 9 PMIC. No 'default': FS_SHARED_INFO_NONE (0) carries no shared data and must not be shown as Mcu.",
              "name": "Shared",
              "discriminator": "e_SharedInfoID",
              "cases": {
                "1": "Mcu", "2": "Task", "3": "Os", "4": "Voltage", "5": "OsState",
                "6": "Fccu", "7": "Stacks", "8": "Pmic"
              }
            }
          ]
        },
        "FS_SafeSection_t_OsException": {
          "name": "FS_SafeSection_t_OsException",
          "fields": [
            { "name": "u_TaskModuleName", "format": { "kind": "hex" } },
            { "name": "u_OsErrorNumber", "format": { "kind": "both" } },
            { "name": "u_OsErrorDetails", "format": { "kind": "hex" } }
          ]
        },
        "FS_SafeSection_t_OsState": {
          "name": "FS_SafeSection_t_OsState",
          "fields": [
            { "name": "a_TaskName", "format": { "kind": "ascii" } },
            { "name": "u_InstrAddress", "format": { "kind": "hex" } },
            { "name": "u_MachineState", "format": { "kind": "hex" } },
            { "name": "u_StackPointer", "format": { "kind": "hex" } }
          ]
        },
        "FS_SafeSection_t_TaskMonException": {
          "name": "FS_SafeSection_t_TaskMonException",
          "fields": [
            { "name": "u_ComponentId", "format": { "kind": "both" } }
          ]
        },
        "FS_SafeSection_t_Voltage": {
          "name": "FS_SafeSection_t_Voltage",
          "fields": [
            { "name": "u_EnableFlags", "format": { "kind": "hex" } },
            { "name": "u_FaultFlags", "format": { "kind": "hex" } }
          ]
        },
        "FS_SafeSection_t_Pmic": {
          "name": "FS_SafeSection_t_Pmic",
          "fields": [
            { "name": "u_DeviceID", "format": { "kind": "both" } },
            { "name": "u_ErrFlags", "format": { "kind": "hex" } }
          ]
        },
        "FS_SafeSection_t_NvmIndex": {
          "_comment": "The SafeSection index NvM block stores ONE uint8: the index of the newest record (FS_SafeSection_u_GetNextNvmIndex writes &u_NvmIndex). Records rotate: block = Record0 + u_Index % SAFE_SECTION_NVM_BLOCKS (3).",
          "name": "FS_SafeSection_t_NvmIndex",
          "fields": [
            { "name": "u_NvmIndex", "type": "u8" }
          ]
        },
        "FS_SafeSection_t_McuException": {
          "name": "FS_SafeSection_t_McuException",
          "fields": [
            { "name": "u_ExceptFlags", "format": { "kind": "hex" } },
            { "name": "u_MachineState", "format": { "kind": "hex" } },
            { "name": "u_InstrAddress", "format": { "kind": "hex" } },
            { "name": "u_DataAddress", "format": { "kind": "hex" } },
            { "name": "u_StackPointer", "format": { "kind": "hex" } }
          ]
        },
        "Dem_Cfg_PrimaryEntryType": {
          "name": "Dem_Cfg_PrimaryEntryType",
          "fields": [
            { "name": "Timestamp", "format": { "kind": "hex" } },
            { "name": "EventId", "format": { "kind": "enum", "enum": "DemEventName" } }
          ]
        }
      },
      "enums": {
        "FS_InfoBlockBuildType": {
          "name": "FS_InfoBlockBuildType",
          "_comment": "SW-version trailing build-type byte (not in FS_Reset_Types.h).",
          "values": { "0": "BT_DO_NOT_USE", "1": "BT_PRERELEASE", "2": "BT_TESTVERSION", "3": "BT_NIGHTLYBUILDS", "16": "BT_RELEASE" }
        },
        "DemUdsStatus": {
          "name": "DemUdsStatus",
          "_comment": "UDS DEM status-byte bit labels (bit index -> label), used with format.kind=bitflags. Not present in Dem_Lcfg.h.",
          "values": {
            "0": "Test failed",
            "1": "Test failed this operation cycle",
            "2": "Pending DTC",
            "3": "Confirmed DTC",
            "4": "Test not completed since last clear",
            "5": "Test failed since last clear",
            "6": "Test not completed this oper. cycle",
            "7": "Warning indicator requested"
          }
        }
      }
    },
    "blockStructs": [
      { "match": { "nameGlob": "Nvm_SafeSection_Data_Record*" }, "struct": "FS_SafeSection_t_Data" },
      { "match": { "name": "Nvm_SafeSection_Index" }, "struct": "FS_SafeSection_t_NvmIndex" },
      { "match": { "nameGlob": "DemPrimaryDataBlock*" }, "struct": "Dem_Cfg_PrimaryEntryType" }
    ]
  }
}
